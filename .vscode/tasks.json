{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake Configure",
            "type": "shell",
            "command": "cmake -B build -S .",
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": []
        },
        {
            "label": "CMake Build",
            "type": "shell",
            "command": "cmake -B build -S .; cmake --build build",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$msCompile"
            ]
        },
        {
            "label": "CMake Build Parallel",
            "type": "shell",
            "command": "cmake -B build -S .; cmake --build build --parallel 8",
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": [
                "$msCompile"
            ]
        },
        {
            "label": "CMake Rebuild",
            "type": "shell",
            "command": "cmake -B build -S .; cmake --build build --target clean; cmake --build build",
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": [
                "$msCompile"
            ]
        },
        {
            "label": "CMake Rebuild Parallel",
            "type": "shell",
            "command": "cmake -B build -S .; cmake --build build --target clean; cmake --build build --parallel 8",
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": [
                "$msCompile"
            ]
        },
        {
            "label": "CMake Clean",
            "type": "shell",
            "command": "cmake --build build --target clean",
            "group": {
                "kind": "build",
                "isDefault": false
            }
        },
        {
            "label": "CMake Full Reset",
            "type": "shell",
            "command": "rmdir /s /q build & cmake -B build -S .",
            "group": {
                "kind": "build",
                "isDefault": false
            }
        }
    ]
}